generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  EMPLOYEE
}

enum CustomerAssetType {
  ID_PHOTO
  FACE_PHOTO
}

enum VisitStatus {
  ACTIVE
  CHECKED_OUT
  FORCED_OUT
}

enum VisitResultType {
  WIN
  LOSS
  EVEN
}

enum VisitFinancialStatus {
  RECORDED
  CORRECTED
}

enum ClosureActionType {
  FORCE_CHECKOUT_ALL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         UserRole
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdCustomers Customer[]      @relation("CustomerCreatedBy")
  updatedCustomers Customer[]      @relation("CustomerUpdatedBy")
  uploads          CustomerAsset[]
  checkIns         Visit[]         @relation("VisitCheckInBy")
  checkOuts        Visit[]         @relation("VisitCheckOutBy")
  closures         ClosureEvent[]
  auditLogs        AuditLog[]
  financialRecords VisitFinancial[] @relation("VisitFinancialRecordedBy")
  financialFixes   VisitFinancial[] @relation("VisitFinancialCorrectedBy")

  @@map("users")
}

model Customer {
  id              String   @id @default(cuid())
  internalCode    String?  @unique @map("internal_code")
  fullName        String   @map("full_name")
  phone           String
  address         String
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdByUserId String?  @map("created_by_user_id")
  updatedByUserId String?  @map("updated_by_user_id")

  createdBy User? @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("CustomerUpdatedBy", fields: [updatedByUserId], references: [id])

  assets CustomerAsset[]
  visits Visit[]

  @@index([fullName])
  @@index([phone])
  @@map("customers")
}

model CustomerAsset {
  id               String            @id @default(cuid())
  customerId       String            @map("customer_id")
  assetType        CustomerAssetType @map("asset_type")
  storageKey       String            @map("storage_key")
  mimeType         String            @map("mime_type")
  sizeBytes        Int               @map("size_bytes")
  uploadedByUserId String?           @map("uploaded_by_user_id")
  isActive         Boolean           @default(true) @map("is_active")
  replacedAt       DateTime?         @map("replaced_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  customer   Customer @relation(fields: [customerId], references: [id])
  uploadedBy User?    @relation(fields: [uploadedByUserId], references: [id])

  @@index([customerId, assetType])
  @@map("customer_assets")
}

model Visit {
  id             String      @id @default(cuid())
  customerId     String      @map("customer_id")
  status         VisitStatus @default(ACTIVE)
  checkInAt      DateTime    @default(now()) @map("check_in_at")
  checkOutAt     DateTime?   @map("check_out_at")
  checkInByUserId  String    @map("check_in_by_user_id")
  checkOutByUserId String?   @map("check_out_by_user_id")
  forcedReason   String?     @map("forced_reason")
  closureEventId String?     @map("closure_event_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  customer   Customer     @relation(fields: [customerId], references: [id])
  checkInBy  User         @relation("VisitCheckInBy", fields: [checkInByUserId], references: [id])
  checkOutBy User?        @relation("VisitCheckOutBy", fields: [checkOutByUserId], references: [id])
  closureEvent ClosureEvent? @relation(fields: [closureEventId], references: [id])

  financial VisitFinancial?

  @@index([status, checkInAt])
  @@index([customerId, status])
  @@index([checkOutAt])
  @@map("visits")
}

model VisitFinancial {
  id               String              @id @default(cuid())
  visitId          String              @unique @map("visit_id")
  resultType       VisitResultType     @map("result_type")
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @default("EUR")
  status           VisitFinancialStatus @default(RECORDED)
  recordedByUserId String              @map("recorded_by_user_id")
  recordedAt       DateTime            @default(now()) @map("recorded_at")
  correctionReason String?             @map("correction_reason")
  correctedByUserId String?            @map("corrected_by_user_id")
  correctedAt      DateTime?           @map("corrected_at")

  visit        Visit  @relation(fields: [visitId], references: [id])
  recordedBy   User   @relation("VisitFinancialRecordedBy", fields: [recordedByUserId], references: [id])
  correctedBy  User?  @relation("VisitFinancialCorrectedBy", fields: [correctedByUserId], references: [id])

  @@index([status, recordedAt])
  @@map("visit_financials")
}

model ClosureEvent {
  id                 String           @id @default(cuid())
  actionType         ClosureActionType @map("action_type")
  reason             String
  executedByUserId   String           @map("executed_by_user_id")
  executedAt         DateTime         @default(now()) @map("executed_at")
  affectedVisitsCount Int             @map("affected_visits_count")

  executedBy User   @relation(fields: [executedByUserId], references: [id])
  visits     Visit[]

  @@index([executedAt])
  @@map("closure_events")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  action      String
  reason      String?
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  id                              Int      @id @default(1)
  defaultCurrency                 String   @default("EUR") @map("default_currency")
  maxImageSizeMb                  Int      @default(5) @map("max_image_size_mb")
  signedUrlTtlSeconds             Int      @default(300) @map("signed_url_ttl_seconds")
  allowEmployeeViewSensitiveImages Boolean @default(false) @map("allow_employee_view_sensitive_images")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
